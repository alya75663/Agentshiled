{
  "name": "EvaluationTest",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "benign",
        "attack"
      ]
    },
    "input": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "trust_level": {
      "type": "string",
      "enum": [
        "trusted",
        "untrusted"
      ]
    },
    "expected_decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "BLOCK",
        "ASK_USER"
      ]
    },
    "actual_decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "BLOCK",
        "ASK_USER"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "last_run": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "category",
    "input",
    "expected_decision"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}