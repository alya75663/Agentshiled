{
  "name": "Action",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "action_type": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "planner_response": {
      "type": "object"
    },
    "raw_planner_text": {
      "type": "string"
    }
  },
  "required": [
    "action_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}