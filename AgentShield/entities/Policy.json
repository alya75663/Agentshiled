{
  "name": "Policy",
  "type": "object",
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "action_match",
        "time_condition",
        "source_trust",
        "combined",
        "all"
      ]
    },
    "effect": {
      "type": "string",
      "enum": [
        "BLOCK",
        "ASK_USER",
        "ALLOW"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "number",
      "default": 100
    },
    "rule": {
      "type": "object"
    }
  },
  "required": [
    "policy_id",
    "name",
    "effect"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}