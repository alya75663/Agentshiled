{
  "name": "Decision",
  "type": "object",
  "properties": {
    "action_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "BLOCK",
        "ASK_USER"
      ]
    },
    "policy_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "executed": {
      "type": "boolean",
      "default": false
    },
    "timeline": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "decision"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}